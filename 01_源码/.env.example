# ===== 行测 AI 问答助手 · 环境变量示例 =====
# 复制为 `.env` 后按需填写；本项目 API Key 默认由用户在浏览器内配置并存在 localStorage，
# 不强制使用 .env。下方的 VITE_ 变量会打包进前端产物，请勿放入敏感密钥。

# Vite dev server 端口（可选）
# VITE_PORT=5173

# 可选的默认 DeepSeek Key（谨慎：会打进前端产物，仅用于本地自用体验；正式使用请在应用内填写）
# VITE_DEFAULT_TEXT_KEY=
# VITE_DEFAULT_VISION_KEY=

# 默认模型名（可选，覆盖前端默认值）
# VITE_TEXT_MODEL=deepseek-v4-flash
# VITE_VISION_MODEL=deepseek-v4-flash-vision-exp
